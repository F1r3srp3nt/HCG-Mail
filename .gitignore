# Build output
bin/
obj/
artifacts/
publish/
*.user
*.suo
.vs/
.idea/
.vscode/
*.swp
.DS_Store

# Test output
TestResults/
*.trx
coverage*/

# Local runtime data (never commit mailbox data or logs)
*.log
*.db
*.db-shm
*.db-wal

# Apple signing material and iOS build products (never commit)
*.ipa
*.xcarchive
*.mobileprovision
*.provisionprofile
*.p12
*.p8
*.cer
*.dSYM/
# Xcode per-user state (HCGMail.xcodeproj keeps only the project and shared schemes)
xcuserdata/
*.xcuserstate

# Local OAuth client values (may contain the Google desktop client secret) — never commit
oauth-clients.local.props

__pycache__/

# HCG Mail Unleashed CI output (.github/workflows/unleashed.yml)
unleashed-out/

# HCG Mail Distribution/: local drop folders for executables. Only the README.md files are tracked; every file or folder
# copied into an OS/architecture folder (installers, ZIPs, .app bundles, portable folders) stays out of Git.
/HCG Mail Distribution/**
!/HCG Mail Distribution/README.md
!/HCG Mail Distribution/*/
!/HCG Mail Distribution/*/README.md
!/HCG Mail Distribution/*/*/
!/HCG Mail Distribution/*/*/README.md

# This Mac's iOS signing choice (identity and profile names; template: HCG Mail Project/iOS/signing.local.example.props)
signing.local.props
