<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>HCG.Mail.App</RootNamespace>
    <AssemblyName>HCGMail</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Icons\hcg-mail.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- macOS: Contents/MacOS must hold code only. Published normally, it holds ~230 managed assemblies and JSON files,
       which codesign can sign only in extended attributes; ZIP tools, installer payloads and file transfers can drop
       those, and macOS then reports the app as damaged. Single-file publishing leaves one Mach-O host (managed code
       inside it) and the native libraries next to it, each signed in its own Mach-O signature. Native libraries are not
       self-extracted: extracted copies would not carry HCG's Developer ID signature, and the hardened runtime's library
       validation would refuse them. Windows and Linux builds are unchanged. See docs/MACOS_SIGNING.md. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- Debug information inside the assemblies: a single-file app cannot use .pdb files next to it, and they would be
         data files in Contents/MacOS. The referenced projects are built the same way (below). -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HCG.Mail.Core\HCG.Mail.Core.csproj" />
    <ProjectReference Include="..\HCG.Mail.Email\HCG.Mail.Email.csproj" />
    <ProjectReference Include="..\HCG.Mail.Infrastructure\HCG.Mail.Infrastructure.csproj" />
    <ProjectReference Include="..\HCG.Mail.Presentation\HCG.Mail.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <ProjectReference Update="@(ProjectReference)" AdditionalProperties="DebugType=embedded" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.HtmlRenderer" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HCG.Mail.App.Tests" />
  </ItemGroup>
  <!-- Mailbox sign-in registrations from ../../oauth-clients.props (Microsoft client ID; Google client ID and the
       desktop client secret, which Google does not treat as confidential for installed apps). Empty values make the
       app report that sign-in is not set up. See docs/MICROSOFT_ACCOUNTS.md and docs/GOOGLE_ACCOUNTS.md. -->
  <ItemGroup>
    <AssemblyMetadata Include="HcgReleaseChannel" Value="$(HcgReleaseChannel)" />
    <AssemblyMetadata Include="HcgMicrosoftClientId" Value="$(HcgMicrosoftClientId)" />
    <AssemblyMetadata Include="HcgGoogleClientId" Value="$(HcgGoogleClientId)" />
    <AssemblyMetadata Include="HcgGoogleClientSecret" Value="$(HcgGoogleClientSecret)" />
  </ItemGroup>
  <Import Project="../../oauth-clients.targets" />
</Project>
