<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HCG.Mail.App.ViewModels"
        xmlns:views="using:HCG.Mail.App.Views"
        xmlns:controls="using:HCG.Mail.App.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="HCG.Mail.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="HCG Mail"
        Icon="/Assets/Icons/hcg-mail.ico"
        Width="1380" Height="880" MinWidth="1040" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="38"
        chrome:WindowDrawnDecorations.TitleBarDecorations="MinimizeButton, MaximizeButton, CloseButton">
  <!-- The window shows exactly one HCG Mail wordmark: the brand mark at the top of the sidebar. The title bar is a plain
       drag area with the caption buttons only. Drawing a second "HCG MAIL" title there overlapped the system's own
       caption text on some Windows versions and display scalings. Window.Title stays "HCG Mail" for the taskbar,
       Alt+Tab and screen readers. -->

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding ComposeCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Gesture="Ctrl+R" Command="{Binding ReplyCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+R" Command="{Binding ReplyAllCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding ForwardCommand}" />
    <KeyBinding Gesture="Ctrl+U" Command="{Binding ToggleReadCommand}" CommandParameter="{x:Null}" />
    <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Custom title bar (Windows/macOS when the client area extends into the window chrome) -->
    <Border x:Name="TitleBar" Grid.Row="0" Height="38" Background="{DynamicResource Hcg.Bg.TitleBar}"
            BorderBrush="{DynamicResource Hcg.Border.Subtle}" BorderThickness="0,0,0,1"
            IsVisible="{Binding $parent[Window].IsExtendedIntoWindowDecorations}">
    </Border>

    <!-- Development preview banner -->
    <Border Grid.Row="1" IsVisible="{Binding IsPreviewMode}" Background="{DynamicResource Hcg.Bg.Preview}" Padding="16,6">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
        <controls:IconView Data="{StaticResource Icon.Warning}" Width="15" Height="15" Foreground="{DynamicResource Hcg.Text.Preview}" />
        <TextBlock Foreground="{DynamicResource Hcg.Text.Preview}" FontWeight="SemiBold" FontSize="12"
                   Text="DEVELOPMENT PREVIEW — sample messages only. Not connected to any mail server; nothing is sent." />
      </StackPanel>
    </Border>

    <!-- Three panes -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <!-- MinWidth of the window (1040) covers these columns at their default and minimum widths (256 + 400 + 1 + 380):
             below that the reader column was pushed past the window edge and cut off. -->
        <ColumnDefinition Width="256" MinWidth="220" MaxWidth="420" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="400" MinWidth="300" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" MinWidth="380" />
      </Grid.ColumnDefinitions>
      <views:NavigationPane Grid.Column="0" />
      <GridSplitter x:Name="NavigationSplitter" Grid.Column="1" ResizeDirection="Columns" />
      <views:MessageListPane x:Name="MessageListPane" Grid.Column="2" />
      <GridSplitter Grid.Column="3" ResizeDirection="Columns" />
      <views:ReaderPane Grid.Column="4" />
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="3" Background="{DynamicResource Hcg.Bg.TitleBar}" BorderBrush="{DynamicResource Hcg.Border.Subtle}" BorderThickness="0,1,0,0" Padding="14,5">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <controls:IconView Data="{StaticResource Icon.Lock}" Width="12" Height="12" Foreground="{DynamicResource Hcg.Text.Tertiary}" />
          <TextBlock FontSize="11" Foreground="{DynamicResource Hcg.Text.Tertiary}" Text="Encrypted IMAP/SMTP · remote content blocked by default" />
        </StackPanel>
        <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource Hcg.Text.Tertiary}" Text="{Binding StatusText}" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
