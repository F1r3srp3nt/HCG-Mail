<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HCG.Mail.App.ViewModels"
        xmlns:dl="using:HCG.Mail.Email.Deliverability"
        xmlns:controls="using:HCG.Mail.App.Controls"
        xmlns:core="using:HCG.Mail.Core.Network"
        x:Class="HCG.Mail.App.Views.MailHealthWindow"
        x:DataType="vm:MailHealthViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/Icons/hcg-mail.ico"
        Width="1000" Height="760" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Foreground" Value="{DynamicResource Hcg.Text.Secondary}" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource Hcg.Text.Primary}" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
      <Setter Property="Background" Value="{DynamicResource Hcg.Accent}" />
    </Style>
    <!-- Status badges: the four labels used everywhere in Mail Health -->
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="9,2" />
      <Setter Property="MinWidth" Value="84" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Background" Value="{DynamicResource Hcg.Neutral}" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.badge.verified">
      <Setter Property="Background" Value="{DynamicResource Hcg.Success}" />
    </Style>
    <Style Selector="Border.badge.warning">
      <Setter Property="Background" Value="{DynamicResource Hcg.Warning}" />
    </Style>
    <Style Selector="Border.badge.failed">
      <Setter Property="Background" Value="{DynamicResource Hcg.Danger}" />
    </Style>
    <Style Selector="TextBlock.detail">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource Hcg.Text.Secondary}" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="TextBlock.action">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource Hcg.Text.Accent}" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
  </Window.Styles>

  <Window.DataTemplates>
    <DataTemplate DataType="vm:CheckItemViewModel">
      <Grid ColumnDefinitions="96,*" Margin="0,6">
        <Border Classes="badge" Classes.verified="{Binding IsVerified}" Classes.warning="{Binding IsWarning}" Classes.failed="{Binding IsFailed}">
          <TextBlock Text="{Binding StatusLabel}" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <SelectableTextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Hcg.Text.Secondary}" />
          <TextBlock Classes="action" IsVisible="{Binding HasAction}" Text="{Binding Action, StringFormat='What to do: {0}'}" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource Hcg.Bg.Reader}">
    <!-- Header -->
    <Border Background="{DynamicResource Hcg.Bg.TitleBar}" BorderBrush="{DynamicResource Hcg.Border.Subtle}" BorderThickness="0,0,0,1" Padding="20,12">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <controls:IconView Data="{StaticResource Icon.Shield}" Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Mail Health" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Classes="caption" Text="{Binding AccountAddress}" />
        </StackPanel>
        <Button x:Name="CopyReportButton" Grid.Column="2" Classes="toolbar" Margin="0,0,10,0" ToolTip.Tip="Copy all results as text, e.g. for your mail provider's support" Click="OnCopyReport">
          <TextBlock Text="Copy report" />
        </Button>
        <Border Grid.Column="3" CornerRadius="10" BoxShadow="{DynamicResource Hcg.Shadow.Glow}">
          <Button Classes="primary" Command="{Binding RunChecksCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:IconView Data="{StaticResource Icon.Refresh}" Width="16" Height="16" />
              <TextBlock Text="Run checks" />
            </StackPanel>
          </Button>
        </Border>
      </Grid>
    </Border>

    <TabControl x:Name="Tabs" Grid.Row="1" Margin="12,6,12,0">
      <!-- Network Doctor: is it the network, the password, the server or HCG Mail? -->
      <TabItem x:Name="NetworkTab" Header="Network Doctor" IsVisible="{Binding HasNetwork}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="10,12,10,20" Spacing="14" DataContext="{Binding Network}">
            <Border Classes="card" Padding="16,14">
              <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                <Border Classes="badge" Width="132" VerticalAlignment="Top" Margin="0,2,14,0" IsVisible="{Binding HasDiagnosis}"
                        Classes.verified="{Binding IsHealthy}" Classes.warning="{Binding IsWarning}" Classes.failed="{Binding IsProblem}">
                  <StackPanel>
                    <TextBlock x:Name="NetworkVerdictCategory" Text="{Binding CategoryLabel}" />
                    <TextBlock x:Name="NetworkConfidenceLabel" Text="{Binding ConfidenceLabel}" FontSize="10.5" FontWeight="Normal" />
                  </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock x:Name="NetworkHeadline" Text="{Binding Headline}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding HasDiagnosis}" />
                  <TextBlock Text="Find out why mail does not work on this network" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding !HasDiagnosis}" />
                  <TextBlock x:Name="NetworkConfidence" Classes="action" Text="{Binding ConfidenceText}" IsVisible="{Binding HasDiagnosis}" />
                  <TextBlock x:Name="NetworkExplanation" Classes="detail" Text="{Binding Explanation}" IsVisible="{Binding HasDiagnosis}" />
                  <TextBlock Classes="detail" IsVisible="{Binding !HasDiagnosis}"
                             Text="Checks the device's connection, Wi-Fi sign-in pages, name lookups, certificate interception, whether this network allows mail ports, and your incoming and outgoing servers — and says whether the network, your password, the server or HCG Mail is the cause." />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                  <Button x:Name="CopyNetworkReportButton" Classes="toolbar" Click="OnCopyNetworkReport"
                          ToolTip.Tip="Copy the results as text for support. Passwords, tokens and message content are never included; addresses keep only their domain.">
                    <TextBlock Text="Copy report" />
                  </Button>
                  <Button x:Name="RunNetworkDoctorButton" Classes="primary" Command="{Binding RunCommand}">
                    <TextBlock Text="Run Network Doctor" />
                  </Button>
                </StackPanel>
                <ItemsControl Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0" ItemsSource="{Binding Actions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Classes="action" Text="{Binding StringFormat='• {0}'}" Margin="0,2" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Classes="caption" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding StatusText}" />
              </Grid>
            </Border>

            <Border Classes="card" Padding="16,12" IsVisible="{Binding HasAlternatives}">
              <StackPanel Spacing="8">
                <TextBlock Text="Another way to send that works on this network" FontWeight="SemiBold" />
                <ItemsControl x:Name="AlternativeList" ItemsSource="{Binding Alternatives}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:AlternativeEndpoint">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                          <TextBlock Classes="detail" Text="{Binding Source, StringFormat='{}{0}. Fully encrypted; the certificate is verified.'}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="subtle" Content="Use this" VerticalAlignment="Center"
                                Command="{Binding $parent[ItemsControl].((vm:NetworkDoctorViewModel)DataContext).UseAlternativeCommand}" CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="card" Padding="16,8" IsVisible="{Binding HasDiagnosis}">
              <ItemsControl x:Name="NetworkRows" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NetworkCheckRowViewModel">
                    <Grid ColumnDefinitions="110,*" Margin="0,7">
                      <Border Classes="badge" HorizontalAlignment="Left" VerticalAlignment="Top"
                              Classes.verified="{Binding IsOk}" Classes.warning="{Binding IsWarning}" Classes.failed="{Binding IsProblem}">
                        <TextBlock Text="{Binding ResultLabel}" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <SelectableTextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Hcg.Text.Secondary}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <Border Classes="card" Padding="16,12" IsVisible="{Binding HasOutbox}">
              <StackPanel Spacing="8">
                <TextBlock Text="Outbox" FontWeight="SemiBold" />
                <TextBlock Classes="detail" Text="Messages wait here while the server cannot be reached and are sent automatically when the account reconnects. A message that may already have been sent is never sent again without you." />
                <ItemsControl x:Name="OutboxList" ItemsSource="{Binding Outbox}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OutboxItemViewModel">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="detail" Text="{Binding Recipients, StringFormat='To {0}'}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="action" Text="{Binding StateText}" />
                          <TextBlock Classes="detail" Text="{Binding Detail}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Button Classes="subtle" Content="Send again" IsVisible="{Binding CanSendAgain}"
                                  Command="{Binding $parent[ItemsControl].((vm:NetworkDoctorViewModel)DataContext).SendAgainCommand}" CommandParameter="{Binding}" />
                          <Button Classes="subtle" Content="Discard"
                                  Command="{Binding $parent[ItemsControl].((vm:NetworkDoctorViewModel)DataContext).DiscardCommand}" CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="card" Padding="16,12">
              <StackPanel Spacing="6">
                <TextBlock Text="Connection recovery" FontWeight="SemiBold" />
                <TextBlock Classes="detail" Text="{Binding RecoveryText}" />
                <TextBlock Classes="detail" Text="{Binding VpnText}" />
                <TextBlock Text="Recent network events" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ItemsControl x:Name="NetworkEvents" ItemsSource="{Binding Events}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NetworkEventViewModel">
                      <Grid ColumnDefinitions="72,*" Margin="0,2">
                        <TextBlock Classes="detail" Text="{Binding Time}" />
                        <TextBlock Grid.Column="1" Classes="detail" Text="{Binding Description}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="caption" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding PrivacyText}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Connection: what HCG Mail observed or measured for this account -->
      <TabItem x:Name="ConnectionTab" Header="Connection" IsVisible="{Binding HasConnection}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="10,12,10,20" Spacing="14" DataContext="{Binding Connection}">
            <Border Classes="card" Padding="16,14">
              <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                <Border Classes="badge" Width="96" VerticalAlignment="Top" Margin="0,2,14,0"
                        Classes.verified="{Binding IsHealthy}" Classes.warning="{Binding IsDegraded}" Classes.failed="{Binding IsFailing}">
                  <TextBlock Text="{Binding StateBadge}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock x:Name="ConnectionStateTitle" Text="{Binding StateTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Classes="detail" Text="{Binding StateExplanation}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                  <Button x:Name="CopyDiagnosticsButton" Classes="toolbar" Click="OnCopyDiagnostics"
                          ToolTip.Tip="Copy these results as text for support. Passwords, tokens and message content are never included; addresses keep only their domain.">
                    <TextBlock Text="Copy diagnostics" />
                  </Button>
                  <Button x:Name="CheckConnectionButton" Classes="primary" Command="{Binding CheckConnectionCommand}">
                    <TextBlock Text="Check connection" />
                  </Button>
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="caption" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding CheckStatus}" />
              </Grid>
            </Border>
            <Border Classes="card" Padding="16,8">
              <ItemsControl x:Name="ConnectionRows" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HealthRow">
                    <Grid ColumnDefinitions="110,*" Margin="0,7">
                      <Border Classes="badge" HorizontalAlignment="Left" VerticalAlignment="Top"
                              Classes.verified="{Binding IsOk}" Classes.warning="{Binding IsWarning}" Classes.failed="{Binding IsProblem}">
                        <TextBlock Text="{Binding ResultLabel}" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <SelectableTextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Hcg.Text.Secondary}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Checks -->
      <TabItem Header="Domain &amp; sending checks">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="10,12,10,20" Spacing="14">
            <Border Classes="card" Padding="16,12">
              <StackPanel Spacing="8">
                <TextBlock TextWrapping="Wrap" Classes="detail"
                           Text="These checks read your domain's public DNS records and this computer's send history. HCG Mail cannot change DNS records or your provider's sending servers, and it does not estimate deliverability scores or inbox placement. Each result is Verified, Warning, Failed or Not tested." />
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Text="DKIM selector(s)" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <TextBox Grid.Column="1" Text="{Binding DkimSelectors}" PlaceholderText="Found automatically when you analyze a received message, or enter the selector from your provider" />
                </Grid>
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Sections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CheckSectionViewModel">
                  <Border Classes="card" Padding="16,12" Margin="0,0,0,12">
                    <StackPanel Spacing="4">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Description}" Classes="detail" />
                        </StackPanel>
                        <Border Grid.Column="1" Classes="badge" Classes.verified="{Binding IsVerified}" Classes.warning="{Binding IsWarning}" Classes.failed="{Binding IsFailed}">
                          <TextBlock Text="{Binding StatusLabel}" />
                        </Border>
                      </Grid>
                      <Rectangle Height="1" Fill="{DynamicResource Hcg.Border.Subtle}" Margin="0,6" />
                      <ItemsControl ItemsSource="{Binding Checks}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Received message analysis -->
      <TabItem Header="Analyze a received message">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="10,12,10,20" Spacing="12">
            <Border Classes="card" Padding="16,12">
              <StackPanel Spacing="8">
                <TextBlock Classes="detail"
                           Text="Send a message from HCG Mail to a Gmail or Outlook.com address you own. Open it there and copy the original message — Gmail: ⋮ → Show original → Copy to clipboard (or Download original); Outlook.com: … → View → View message source; Apple Mail: View → Message → Raw Source. Paste it below or open the saved .eml file. The recipient's own SPF, DKIM and DMARC results are shown as recorded; nothing is uploaded anywhere." />
                <TextBox x:Name="RawMessageBox" Text="{Binding RawMessage}" AcceptsReturn="True" TextWrapping="NoWrap" Height="180"
                         FontFamily="Menlo, Consolas, monospace" FontSize="12" PlaceholderText="Paste the original message (headers) here" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Classes="primary" Content="Analyze" Command="{Binding AnalyzeCommand}" />
                  <Button Classes="toolbar" Content="Open .eml file…" Command="{Binding OpenMessageFileCommand}" />
                  <Button Classes="subtle" Content="Clear" Command="{Binding ClearAnalysisCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding AnalysisSummary}" Classes="detail" IsVisible="{Binding AnalysisSummary, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </Border>
            <Border Classes="card" Padding="16,12" IsVisible="{Binding HasAnalysis}">
              <StackPanel Spacing="4">
                <TextBlock Text="Results" FontSize="15" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding AnalysisChecks}" />
                <TextBlock Text="Route (first hop first)" FontWeight="SemiBold" Margin="0,10,0,2" />
                <ItemsControl ItemsSource="{Binding AnalysisHops}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <SelectableTextBlock Text="{Binding}" FontFamily="Menlo, Consolas, monospace" FontSize="12" Foreground="{DynamicResource Hcg.Text.Secondary}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Send history -->
      <TabItem Header="Send history">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="10,12,10,20" Spacing="12">
            <Border Classes="card" Padding="16,12">
              <StackPanel Spacing="6">
                <TextBlock Classes="detail"
                           Text="What your outgoing server replied to each message sent from this computer. 'Accepted' means the server took the message for delivery — not that it reached the recipient." />
                <TextBlock Classes="detail" Text="{Binding DeliveryConfirmationText, StringFormat='Delivery confirmation: {0}'}" />
                <TextBlock Classes="detail" Text="{Binding InboxPlacementText, StringFormat='Inbox placement: {0}'}" />
                <Button Classes="subtle" Content="Clear history" Command="{Binding ClearHistoryCommand}" HorizontalAlignment="Left" IsVisible="{Binding HasHistory}" />
              </StackPanel>
            </Border>
            <TextBlock Classes="detail" Text="No messages have been sent from this account on this computer yet." IsVisible="{Binding !HasHistory}" Margin="6,0" />
            <ItemsControl ItemsSource="{Binding History}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DeliveryRecordViewModel">
                  <Border Classes="card" Padding="14,10" Margin="0,0,0,8">
                    <StackPanel Spacing="2">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding State}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Time}" Classes="caption" />
                      </Grid>
                      <SelectableTextBlock Text="{Binding Reply}" FontFamily="Menlo, Consolas, monospace" FontSize="12" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Explanation}" Classes="detail" />
                      <TextBlock Text="{Binding Details}" Classes="caption" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Reputation -->
      <TabItem Header="Reputation">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="10,12,10,20" Spacing="12">
            <Border Classes="card" Padding="16,12">
              <TextBlock Classes="detail"
                         Text="Reputation is measured separately by each receiving mail system and by blocklist operators. HCG Mail has no access to that data, does not query these services and does not estimate a score. These are the services receivers and providers use; most require you or your provider (who owns the sending servers) to register." />
            </Border>
            <ItemsControl ItemsSource="{Binding ReputationLinks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="dl:ReputationLink">
                  <Border Classes="card" Padding="14,10" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" Classes="detail" />
                        <TextBlock Text="{Binding Url}" Classes="caption" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="toolbar" Content="Open" VerticalAlignment="Center" Margin="12,0,0,0"
                              Command="{Binding $parent[Window].((vm:MailHealthViewModel)DataContext).OpenLinkCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Status -->
    <Border Grid.Row="2" Background="{DynamicResource Hcg.Bg.TitleBar}" BorderBrush="{DynamicResource Hcg.Border.Subtle}" BorderThickness="0,1,0,0" Padding="20,7">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Hcg.Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
