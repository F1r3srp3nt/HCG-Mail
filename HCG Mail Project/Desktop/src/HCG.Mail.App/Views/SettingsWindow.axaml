<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HCG.Mail.App.ViewModels"
        xmlns:views="using:HCG.Mail.App.Views"
        xmlns:controls="using:HCG.Mail.App.Controls"
        x:Class="HCG.Mail.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="HCG Mail settings"
        Icon="/Assets/Icons/hcg-mail.ico"
        Width="900" Height="660" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Styles>
    <Style Selector="TabControl">
      <Setter Property="TabStripPlacement" Value="Left" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="Foreground" Value="{DynamicResource Hcg.Text.Secondary}" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource Hcg.Text.Primary}" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
      <Setter Property="Background" Value="{DynamicResource Hcg.Accent}" />
    </Style>
    <Style Selector="StackPanel.page">
      <Setter Property="Margin" Value="30,26,30,26" />
      <Setter Property="Spacing" Value="14" />
    </Style>
    <Style Selector="Border.option">
      <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style Selector="Border.themeCard">
      <Setter Property="BorderBrush" Value="{DynamicResource Hcg.Border.Default}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.themeCard">
      <Setter Property="BorderBrush" Value="{DynamicResource Hcg.Accent}" />
      <Setter Property="BoxShadow" Value="{DynamicResource Hcg.Shadow.GlowSoft}" />
    </Style>
  </Window.Styles>

  <Border Background="{DynamicResource Hcg.Bg.Reader}">
    <TabControl Background="{DynamicResource Hcg.Bg.Sidebar}">

      <!-- Appearance -->
      <TabItem Header="General">
        <ScrollViewer Background="{DynamicResource Hcg.Bg.Reader}">
          <StackPanel Classes="page">
            <TextBlock Classes="h1" Text="General" />
            <Border Classes="card option" BoxShadow="{DynamicResource Hcg.Shadow.None}">
              <StackPanel Spacing="8">
                <TextBlock Classes="h3" Text="Checking for new messages" />
                <ComboBox x:Name="RefreshChoice" ItemsSource="{Binding RefreshOptions}" SelectedItem="{Binding SelectedRefresh}" MinWidth="320" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Manually (the default): HCG Mail checks for new mail only when you click Refresh (F5), open a folder or start the app, and never contacts the server in the background. Automatic: the open folder is also checked at the chosen interval while HCG Mail is running." />
              </StackPanel>
            </Border>
            <Border Classes="card option" BoxShadow="{DynamicResource Hcg.Shadow.None}">
              <StackPanel Spacing="10">
                <TextBlock Classes="h3" Text="Startup" />
                <ToggleSwitch IsChecked="{Binding ConnectOnStartup}" OnContent="Connect to my accounts when HCG Mail starts" OffContent="Connect to my accounts when HCG Mail starts" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Appearance">
        <ScrollViewer Background="{DynamicResource Hcg.Bg.Reader}">
          <StackPanel Classes="page">
            <TextBlock Classes="h1" Text="Appearance" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Choose a skin. The change applies immediately and does not affect your accounts or connections." />
            <ListBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Background="Transparent">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0,0,14,0" />
                  <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter, ListBoxItem:selected /template/ ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter">
                  <Setter Property="Background" Value="Transparent" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ThemeOption">
                  <Border Classes="card themeCard" BorderThickness="2" Padding="16" BoxShadow="{DynamicResource Hcg.Shadow.None}">
                    <StackPanel Spacing="8">
                      <Border Height="92" CornerRadius="9" ClipToBounds="True">
                        <views:ThemeSwatch Kind="{Binding Kind}" />
                      </Border>
                      <TextBlock Text="{Binding Name}" Classes="h3" />
                      <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Accounts -->
      <TabItem Header="Accounts">
        <ScrollViewer Background="{DynamicResource Hcg.Bg.Reader}">
          <StackPanel Classes="page">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="h1" Text="Accounts" />
              <Button Grid.Column="1" Classes="primary" Command="{Binding AddAccountCommand}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <controls:IconView Data="{StaticResource Icon.Plus}" Width="15" Height="15" StrokeThickness="2" />
                  <TextBlock Text="Add account" />
                </StackPanel>
              </Button>
            </Grid>
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding CredentialStorage, StringFormat='Passwords of IMAP accounts are stored in: {0}'}" />
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowMicrosoftSignIn}">
              <TextBlock Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding MicrosoftSignInStatus}" />
              <Button x:Name="SettingsAddMicrosoftButton" Grid.Column="1" Classes="subtle" Margin="12,0,0,0" Content="Add Microsoft account" Command="{Binding AddMicrosoftAccountCommand}" IsVisible="{Binding ShowMicrosoftSignIn}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowGoogleSignIn}">
              <TextBlock Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding GoogleSignInStatus}" />
              <Button x:Name="SettingsAddGoogleButton" Grid.Column="1" Classes="subtle" Margin="12,0,0,0" Content="Add Google account" Command="{Binding AddGoogleAccountCommand}" IsVisible="{Binding ShowGoogleSignIn}" />
            </Grid>
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Removing an account disconnects it and deletes its saved password or sign-in and its send history from this computer. Mail on the server is never deleted, and HCG Mail keeps no copies of messages on this computer." />
            <ItemsControl ItemsSource="{Binding Accounts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AccountViewModel">
                  <Border Classes="card" Padding="14,12" Margin="0,0,0,10" BoxShadow="{DynamicResource Hcg.Shadow.None}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Hcg.Brush.Avatar}">
                        <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0" Spacing="2">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AddressLine}" Classes="caption" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" TextWrapping="Wrap">
                          <Run Text="{Binding ProviderLabel}" />
                          <Run Text="·" />
                          <Run Text="{Binding StatusText}" />
                        </TextBlock>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="subtle" Content="Reconnect" ToolTip.Tip="Connect to the mail server again"
                                Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).ReconnectAccountCommand}" CommandParameter="{Binding}" />
                        <Button Classes="subtle" Content="Edit" IsVisible="{Binding !UsesOAuth}"
                                Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).EditAccountCommand}" CommandParameter="{Binding}" />
                        <Button Classes="subtle danger" Content="Remove"
                                Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).RemoveAccountCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Mail -->
      <TabItem Header="Reading">
        <ScrollViewer Background="{DynamicResource Hcg.Bg.Reader}">
          <StackPanel Classes="page">
            <TextBlock Classes="h1" Text="Reading" />
            <Border Classes="card option" BoxShadow="{DynamicResource Hcg.Shadow.None}">
              <StackPanel Spacing="10">
                <TextBlock Classes="h3" Text="Message display" />
                <ComboBox x:Name="ViewModeChoice" ItemsSource="{Binding ViewModeOptions}" SelectedItem="{Binding SelectedViewMode}" MinWidth="320" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding SelectedViewMode.Description}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="You can switch any message between Original, Readable and Plain text above its text. Colours are never inverted." />
              </StackPanel>
            </Border>
            <Border Classes="card option" BoxShadow="{DynamicResource Hcg.Shadow.None}">
              <StackPanel Spacing="10">
                <TextBlock Classes="h3" Text="Read status" />
                <ToggleSwitch IsChecked="{Binding MarkAsReadWhenOpened}" OnContent="Mark messages as read when opened" OffContent="Mark messages as read when opened" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Composing">
        <ScrollViewer Background="{DynamicResource Hcg.Bg.Reader}">
          <StackPanel Classes="page">
            <TextBlock Classes="h1" Text="Composing" />
            <Border Classes="card option" BoxShadow="{DynamicResource Hcg.Shadow.None}">
              <StackPanel Spacing="10">
                <TextBlock Classes="h3" Text="Sent messages" />
                <ToggleSwitch IsChecked="{Binding SaveCopyToSentFolder}" OnContent="Save a copy of sent messages in the Sent folder" OffContent="Save a copy of sent messages in the Sent folder" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="HCG Mail checks first whether the server already saved the message, so no duplicates are created." />
              </StackPanel>
            </Border>
            <Border Classes="card option" BoxShadow="{DynamicResource Hcg.Shadow.None}">
              <StackPanel Spacing="6">
                <TextBlock Classes="h3" Text="Drafts" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="While you write, unsaved changes are saved to your Drafts folder on the server every minute (when the account is connected). Closing a message or HCG Mail with unsaved changes always asks first." />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Signatures">
        <ScrollViewer Background="{DynamicResource Hcg.Bg.Reader}">
          <StackPanel Classes="page">
            <TextBlock Classes="h1" Text="Signatures" />
            <Border Classes="card option" BoxShadow="{DynamicResource Hcg.Shadow.None}">
              <StackPanel Spacing="10">
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="Each account can have its own plain-text signature. It is added below a “-- ” line to new messages, and above the quoted text in replies and forwards." />
                <TextBlock Classes="caption" Text="No accounts yet." IsVisible="{Binding !HasAccounts}" />
                <ComboBox x:Name="SignatureAccountChoice" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SignatureAccount}" MinWidth="320" IsVisible="{Binding HasAccounts}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccountViewModel">
                      <TextBlock Text="{Binding AddressLine}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox x:Name="SignatureText" Text="{Binding SignatureText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxLength="2000"
                         PlaceholderText="For example your name, title and phone number" IsVisible="{Binding HasAccounts}" />
                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasAccounts}">
                  <Button x:Name="SaveSignatureButton" Classes="primary" Content="Save signature" Command="{Binding SaveSignatureCommand}" />
                  <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding SignatureStatus}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Privacy &amp; security">
        <ScrollViewer Background="{DynamicResource Hcg.Bg.Reader}">
          <StackPanel Classes="page">
            <TextBlock Classes="h1" Text="Privacy &amp; security" />
            <Border Classes="card option" BoxShadow="{DynamicResource Hcg.Shadow.None}">
              <StackPanel Spacing="10">
                <TextBlock Classes="h3" Text="Remote content" />
                <ToggleSwitch x:Name="RemoteImagesToggle" IsChecked="{Binding LoadRemoteImagesAutomatically}" OnContent="Load remote images automatically" OffContent="Load remote images automatically" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Off (recommended): remote images are blocked until you choose Load remote images in a message. Loading them contacts the sender's servers, which learn that and when you opened the message and see your IP address. Images included in the message itself are always shown. Remote fonts, stylesheets and backgrounds are never loaded." />
              </StackPanel>
            </Border>
            <Border Classes="card option" BoxShadow="{DynamicResource Hcg.Shadow.None}">
              <StackPanel Spacing="10">
                <TextBlock Classes="h3" Text="Links" />
                <ToggleSwitch IsChecked="{Binding ConfirmBeforeOpeningLinks}" OnContent="Show the real destination and ask before opening links" OffContent="Show the real destination and ask before opening links" />
              </StackPanel>
            </Border>
            <Border Classes="card option" BoxShadow="{DynamicResource Hcg.Shadow.None}">
              <StackPanel Spacing="6">
                <TextBlock Classes="h3" Text="Passwords and your mail" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding CredentialStorage, StringFormat='Passwords are stored in {0}, never in a file.'}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="Connections are always encrypted and the server's certificate is always checked. Messages run no scripts, forms or active content. HCG Mail has no telemetry and never sends your messages to HCG, AI services or anyone other than your own mail servers." />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Mail Health">
        <ScrollViewer Background="{DynamicResource Hcg.Bg.Reader}">
          <StackPanel Classes="page">
            <TextBlock Classes="h1" Text="Mail Health" />
            <Border Classes="card option" BoxShadow="{DynamicResource Hcg.Shadow.None}">
              <StackPanel Spacing="10">
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="Mail Health shows, for the selected account, whether sign-in, encryption, folders, synchronization and sending actually work, and checks your domain's sending setup (SPF, DKIM, DMARC). Nothing is changed and no email is sent." />
                <Button x:Name="OpenMailHealthButton" Classes="subtle" Content="Open Mail Health" Command="{Binding OpenMailHealthCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Storage">
        <ScrollViewer Background="{DynamicResource Hcg.Bg.Reader}">
          <StackPanel Classes="page">
            <TextBlock Classes="h1" Text="Storage" />
            <Border Classes="card option" BoxShadow="{DynamicResource Hcg.Shadow.None}">
              <StackPanel Spacing="10">
                <TextBlock Classes="h3" Text="Attachment download location" />
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBox Text="{Binding DownloadDirectory}" IsReadOnly="True" />
                  <Button Grid.Column="1" Classes="subtle" Margin="8,0,0,0" Content="Browse…" Command="{Binding BrowseDownloadDirectoryCommand}" />
                  <Button Grid.Column="2" Classes="ghost" Margin="4,0,0,0" Content="Reset" Command="{Binding ResetDownloadDirectoryCommand}" />
                </Grid>
                <ToggleSwitch IsChecked="{Binding AskWhereToSaveAttachments}" OnContent="Ask where to save each attachment" OffContent="Ask where to save each attachment" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="Attachments are only ever saved — HCG Mail never opens or runs them. File names from the sender are cleaned before saving." />
              </StackPanel>
            </Border>
            <Border Classes="card option" BoxShadow="{DynamicResource Hcg.Shadow.None}">
              <StackPanel Spacing="6">
                <TextBlock Classes="h3" Text="On this device" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="Messages stay on your mail server; HCG Mail does not store copies of them. This folder holds only settings, the account list (without passwords), the send history and a log that is kept for 7 days:" />
                <SelectableTextBlock Text="{Binding DataDirectory}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- About -->
      <TabItem Header="About">
        <ScrollViewer Background="{DynamicResource Hcg.Bg.Reader}">
          <StackPanel Classes="page">
            <views:BrandMark />
            <Rectangle Height="1" Fill="{DynamicResource Hcg.Brush.AccentLine}" />
            <TextBlock Classes="h1" Text="HCG Mail" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="An independent email client in the Hakmi Capital Group ecosystem. Works with any standard IMAP/SMTP mailbox and does not require an HCG account, HCG Connect, HCG ERP or any HCG server." />
            <Border Classes="card option" BoxShadow="{DynamicResource Hcg.Shadow.None}">
              <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" >
                <Grid.Styles>
                  <Style Selector="TextBlock">
                    <Setter Property="Margin" Value="0,4" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                  </Style>
                </Grid.Styles>
                <TextBlock Classes="caption" Text="Version" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding Version}" Margin="0,4" />
                <TextBlock Grid.Row="1" Classes="caption" Text="Runtime" />
                <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Runtime}" Margin="0,4" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Classes="caption" Text="Password storage" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CredentialStorage}" />
                <TextBlock Grid.Row="3" Classes="caption" Text="Settings folder" />
                <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DataDirectory}" Margin="0,4" TextWrapping="Wrap" />
                <TextBlock Grid.Row="4" Classes="caption" Text="Privacy" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="No telemetry. Credentials and messages are only exchanged with your own mail servers. Message bodies are not cached on disk." />
              </Grid>
            </Border>
            <Border Classes="banner">
              <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Hcg.Text.Secondary}"
                         Text="The HCG logo and the HCG Mail application icon are official Hakmi Capital Group artwork." />
            </Border>
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="Built with .NET, Avalonia UI, MailKit/MimeKit (MIT), HtmlSanitizer (MIT), HtmlRenderer (BSD-3) and the Inter typeface (OFL)." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Border>
</Window>
