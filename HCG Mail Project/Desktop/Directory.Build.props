<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>

    <Version>0.1.0</Version>
    <!-- Shown in Settings › About. Follows Version unless set: a build stamped with a pre-release version
         (-p:Version=0.1.0-beta.1, as HCG Executable Maker does) shows exactly that. Version itself stays numeric
         here because the iOS app uses it as CFBundleShortVersionString. -->
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Release capability flags (HCG.Mail.Core/Release/ReleaseCapabilities.cs, docs/RELEASE_CAPABILITIES.md).
         PublicBeta (the default): IMAP and SMTP only; Microsoft and Google sign-in are hidden but kept in the code.
         Internal: development builds with every implemented feature. -p:HcgReleaseChannel=Internal or the
         HCG_RELEASE_CHANNEL environment variable. Any other value counts as PublicBeta (the app fails closed). -->
    <HcgReleaseChannel Condition="'$(HcgReleaseChannel)' == ''">$(HCG_RELEASE_CHANNEL)</HcgReleaseChannel>
    <HcgReleaseChannel Condition="'$(HcgReleaseChannel)' != 'Internal'">PublicBeta</HcgReleaseChannel>
    <Company>Hakmi Capital Group</Company>
    <Product>HCG Mail</Product>
    <Copyright>© Hakmi Capital Group</Copyright>
  </PropertyGroup>

  <!-- Microsoft and Google sign-in registrations, shared by every build (desktop, iOS, CI, HCG Executable Maker). -->
  <Import Project="$(MSBuildThisFileDirectory)oauth-clients.props" />
</Project>
