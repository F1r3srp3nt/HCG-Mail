<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless UI tests: real views and view models rendered with Skia, no display required. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 advisory: pass TestContext.Current.CancellationToken to async calls. The tests use their own timeouts. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="MailKit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\HCG.Mail.App\HCG.Mail.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test doubles shared with the engine tests: a manual clock and a mail session whose server can be switched off. -->
    <Compile Include="..\HCG.Mail.Tests\Network\ManualTimeProvider.cs" Link="Shared\ManualTimeProvider.cs" />
    <Compile Include="..\HCG.Mail.Tests\Network\SwitchableSession.cs" Link="Shared\SwitchableSession.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
