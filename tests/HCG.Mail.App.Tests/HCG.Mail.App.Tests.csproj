  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\HCG.Mail.App\HCG.Mail.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
