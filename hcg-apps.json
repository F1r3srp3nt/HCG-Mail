{
  "$comment": "Machine-readable index of the applications in this repository, for build tools such as HCG Executable Maker. Paths are relative to the repository root. One code base: the iOS app references the shared projects listed under 'sharedRoot'; do not copy a single folder out of the checkout.",
  "schema": "hcg-apps/1",
  "repository": "HCG-Mail",
  "applications": [
    {
      "id": "hcg-mail-desktop",
      "name": "HCG Mail (desktop)",
      "platforms": ["windows", "macos", "linux"],
      "project": "HCG Mail Project/Desktop/src/HCG.Mail.App/HCG.Mail.App.csproj",
      "solution": "HCG Mail Project/Desktop/HCG.Mail.sln",
      "targetFramework": "net10.0",
      "outputType": "WinExe",
      "buildHost": ["windows", "macos", "linux"],
      "build": "dotnet publish \"HCG Mail Project/Desktop/src/HCG.Mail.App/HCG.Mail.App.csproj\" -c Release -r win-x64 --self-contained",
      "docs": "HCG Mail Project/Desktop/docs/WINDOWS_BUILD.md"
    },
    {
      "id": "hcg-mail-ios",
      "name": "HCG Mail for iPhone and iPad",
      "platforms": ["ios"],
      "project": "HCG Mail Project/iOS/src/HCG.Mail.iOS/HCG.Mail.iOS.csproj",
      "solution": "HCG Mail Project/iOS/HCG.Mail.iOS.sln",
      "workingDirectory": "HCG Mail Project/iOS",
      "targetFramework": "net10.0-ios",
      "outputType": "Exe",
      "bundleId": "com.hakmicapitalgroup.hcgmail",
      "buildHost": ["macos"],
      "toolchain": "HCG Mail Project/iOS/toolchain.props",
      "sharedRoot": "HCG Mail Project/Desktop",
      "sharedRootOverride": "-p:HcgSharedRoot=<absolute path to HCG Mail Project/Desktop> or environment HCG_SHARED_ROOT",
      "check": "HCG Mail Project/iOS/scripts/doctor.sh",
      "xcodeProject": "HCG Mail Project/iOS/HCGMail.xcodeproj",
      "xcodeSchemes": {
        "HCG Mail": "builds the app through the .NET build (simulator, or unsigned compile for devices); Archive is not supported",
        "HCG Mail Simulator": "builds, installs and starts the app in the iOS Simulator"
      },
      "build": {
        "simulator": "\"HCG Mail Project/iOS/scripts/build-simulator.sh\" Debug",
        "device": "dotnet build \"HCG Mail Project/iOS/src/HCG.Mail.iOS/HCG.Mail.iOS.csproj\" -c Release -f net10.0-ios -r ios-arm64 -p:CodesignKey=<identity> -p:CodesignProvision=<profile>",
        "ipa": "\"HCG Mail Project/iOS/scripts/export-ipa.sh\""
      },
      "verify": "python3 \"HCG Mail Project/iOS/scripts/verify-ios-build.py\" app <.app or .ipa>",
      "docs": "HCG Mail Project/iOS/README.md",
      "submission": "HCG Mail Project/iOS/APP_STORE_SUBMISSION.md"
    }
  ],
  "libraries": [
    "HCG Mail Project/Desktop/src/HCG.Mail.Core/HCG.Mail.Core.csproj",
    "HCG Mail Project/Desktop/src/HCG.Mail.Email/HCG.Mail.Email.csproj",
    "HCG Mail Project/Desktop/src/HCG.Mail.Infrastructure/HCG.Mail.Infrastructure.csproj",
    "HCG Mail Project/Desktop/src/HCG.Mail.Presentation/HCG.Mail.Presentation.csproj",
    "HCG Mail Project/iOS/src/HCG.Mail.Mobile/HCG.Mail.Mobile.csproj"
  ],
  "tests": [
    "HCG Mail Project/Desktop/tests/HCG.Mail.Tests/HCG.Mail.Tests.csproj",
    "HCG Mail Project/Desktop/tests/HCG.Mail.App.Tests/HCG.Mail.App.Tests.csproj",
    "HCG Mail Project/iOS/tests/HCG.Mail.Mobile.Tests/HCG.Mail.Mobile.Tests.csproj"
  ]
}
