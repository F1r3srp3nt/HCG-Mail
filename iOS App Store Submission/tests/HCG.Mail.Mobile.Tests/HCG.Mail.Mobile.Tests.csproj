<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless tests of the iPhone/iPad interface: the real mobile views and shared view models rendered with Skia at
    iPhone and iPad sizes, in preview mode (in-memory sample mailbox, never a real server). Runs on Linux, macOS and
    Windows without Apple tooling. What these tests cannot cover (Keychain, MSAL redirect, UIKit share sheet, Dynamic
    Type notifications) is exercised by the simulator self-test in HCG.Mail.iOS.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="MailKit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/HCG.Mail.Mobile/HCG.Mail.Mobile.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Where the shared test fixtures are, as resolved by Directory.Build.props (no machine-specific paths). -->
    <AssemblyMetadata Include="HcgSharedDir" Value="$(HcgSharedDir)" />
  </ItemGroup>
</Project>
