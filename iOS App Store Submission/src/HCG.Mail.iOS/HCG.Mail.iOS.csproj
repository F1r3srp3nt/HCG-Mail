<Project Sdk="Microsoft.NET.Sdk">
  <!--
    HCG Mail for iPhone and iPad: a .NET for iOS app that hosts the shared Avalonia interface (HCG.Mail.Mobile) and
    the shared mail engine (HCG.Mail.Core / HCG.Mail.Email). It is built with Apple's toolchain (Xcode's SDK, actool
    for the asset catalog, ibtool for the launch screen, codesign) through the .NET iOS workload; it is not a SwiftUI
    or Xcode project and there is deliberately no .xcodeproj. See ../../README.md for versions and commands.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
    <RootNamespace>HCG.Mail.iOS</RootNamespace>
    <AssemblyName>HCGMail.iOS</AssemblyName>

    <!-- Bundle identifier: must match the App ID registered by Hakmi Capital Group in the Apple Developer account and
         the msauth.<bundle id> URL scheme in Info.plist. Override with -p:HcgBundleId=... only together with Info.plist. -->
    <HcgBundleId Condition="'$(HcgBundleId)' == ''">com.hakmicapitalgroup.hcgmail</HcgBundleId>
    <ApplicationId>$(HcgBundleId)</ApplicationId>
    <ApplicationTitle>HCG Mail</ApplicationTitle>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <!-- CFBundleVersion: increase for every upload (-p:ApplicationVersion=N). -->
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1</ApplicationVersion>

    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <!-- Simulator builds carry the same entitlements, so they must be signed; ad-hoc signing ("-") needs no
         certificate. Device builds always need a real identity (CodesignKey), passed by the scripts. -->
    <CodesignKey Condition="'$(CodesignKey)' == '' And $(RuntimeIdentifier.StartsWith('iossimulator'))">-</CodesignKey>
    <!-- Trim only Apple SDK assemblies: the app uses dependency injection and compiled XAML that must keep its types. -->
    <TrimMode>partial</TrimMode>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- Fast simulator iteration; Release builds are fully AOT-compiled as the App Store requires. -->
    <UseInterpreter>true</UseInterpreter>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HCG.Mail.Mobile/HCG.Mail.Mobile.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Microsoft.Identity.Client" />
  </ItemGroup>

  <ItemGroup>
    <!-- Assets.xcassets (AppIcon: the supplied HCG Mail icon, 1024 px, opaque) is included as ImageAsset by default
         and compiled by actool; Info.plist points XSAppIconAssets at it. -->
    <!-- App Store privacy manifest: no tracking, no data collected by the developer; required-reason APIs used by .NET. -->
    <BundleResource Include="PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
  </ItemGroup>

  <!-- Microsoft application (client) ID for Outlook.com / Microsoft 365 sign-in. Public, not a secret.
       Empty by default, which shows Microsoft sign-in as "not set up": pass -p:HcgMicrosoftClientId=<GUID>.
       The iOS trimmer strips assembly metadata attributes, so the value is compiled into a constant instead. -->
  <Target Name="HcgWriteBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_HcgBuildInfoFile>$(IntermediateOutputPath)HcgBuildInfo.g.cs</_HcgBuildInfoFile>
      <_HcgClientIdLiteral>$(HcgMicrosoftClientId.Trim().Replace('"', '""'))</_HcgClientIdLiteral>
    </PropertyGroup>
    <WriteLinesToFile File="$(_HcgBuildInfoFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="namespace HCG.Mail.iOS%3B;internal static class HcgBuildInfo { public const string MicrosoftClientId = @&quot;$(_HcgClientIdLiteral)&quot;%3B }" />
    <ItemGroup>
      <Compile Include="$(_HcgBuildInfoFile)" />
      <FileWrites Include="$(_HcgBuildInfoFile)" />
    </ItemGroup>
  </Target>
</Project>
