<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:HCG.Mail.App.ViewModels"
             xmlns:accounts="using:HCG.Mail.Core.Accounts"
             xmlns:controls="using:HCG.Mail.App.Controls"
             x:Class="HCG.Mail.Mobile.Views.AccountSetupView"
             x:DataType="app:AccountSetupViewModel">
  <UserControl.Styles>
    <Style Selector="StackPanel.field">
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="controls|IconView.stepIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
  </UserControl.Styles>
  <Border Background="{DynamicResource Hcg.Bg.Reader}">
    <Grid RowDefinitions="Auto,*">
      <Border Classes="navBar">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button x:Name="CancelButton" Classes="link" Content="Cancel" Command="{Binding CancelCommand}" Margin="6,0" />
          <TextBlock Grid.Column="1" Classes="navTitle" Text="{Binding Title}" HorizontalAlignment="Center" />
          <Button x:Name="SaveButton" Grid.Column="2" Classes="primary" Content="Save" Command="{Binding SaveCommand}" Margin="0,0,6,0" />
        </Grid>
      </Border>

      <ScrollViewer x:Name="Scroller" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,14,16,28" MaxWidth="640">
          <TextBlock Classes="muted" FontSize="15" TextWrapping="Wrap"
                     Text="Connect an existing mailbox with IMAP (incoming) and SMTP (outgoing). Your provider gives you these details." />
          <Border Classes="banner" Margin="0,12,0,0" IsVisible="{Binding CanUseMicrosoft}">
            <StackPanel Spacing="8">
              <TextBlock TextWrapping="Wrap" FontSize="14"
                         Text="Outlook.com, Hotmail or Microsoft 365? Use Microsoft sign-in instead — no password is stored in HCG Mail." />
              <Button x:Name="UseMicrosoftButton" Classes="subtle" Content="Add Microsoft account" Command="{Binding UseMicrosoftCommand}" />
            </StackPanel>
          </Border>
          <Border Classes="banner" Margin="0,12,0,0" IsVisible="{Binding HasIntroMessage}">
            <TextBlock Text="{Binding IntroMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Hcg.Text.Accent}" />
          </Border>

          <TextBlock Classes="section" Text="PROVIDER" Margin="2,18,0,8" />
          <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" HorizontalAlignment="Stretch" AutomationProperties.Name="Provider">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="accounts:ProviderPreset">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="caption" Text="{Binding HostnameHint}" TextWrapping="Wrap" Margin="2,6,0,0" />

          <TextBlock Classes="section" Text="YOUR DETAILS" Margin="2,18,0,8" />
          <StackPanel Classes="field">
            <TextBlock Classes="formLabel" Text="Email address" />
            <TextBox x:Name="EmailBox" Text="{Binding EmailAddress}" TextInputOptions.ContentType="Email" TextInputOptions.AutoCapitalization="False" TextInputOptions.ShowSuggestions="False" Watermark="you@yourdomain.no" Classes.invalid="{Binding EmailError, Converter={x:Static ObjectConverters.IsNotNull}}" AutomationProperties.Name="Email address" />
            <TextBlock Classes="error" Text="{Binding EmailError}" TextWrapping="Wrap" IsVisible="{Binding EmailError, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="2,4,0,0" />
          </StackPanel>
          <StackPanel Classes="field">
            <TextBlock Classes="formLabel" Text="Display name" />
            <TextBox Text="{Binding DisplayName}" Watermark="Name shown to recipients" Classes.invalid="{Binding DisplayNameError, Converter={x:Static ObjectConverters.IsNotNull}}" AutomationProperties.Name="Display name" />
            <TextBlock Classes="error" Text="{Binding DisplayNameError}" TextWrapping="Wrap" IsVisible="{Binding DisplayNameError, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="2,4,0,0" />
          </StackPanel>
          <StackPanel Classes="field">
            <TextBlock Classes="formLabel" Text="Username" />
            <TextBox Text="{Binding Username}" TextInputOptions.ContentType="Email" TextInputOptions.AutoCapitalization="False" TextInputOptions.ShowSuggestions="False" Watermark="Usually your full email address" Classes.invalid="{Binding UsernameError, Converter={x:Static ObjectConverters.IsNotNull}}" AutomationProperties.Name="Username" />
            <TextBlock Classes="error" Text="{Binding UsernameError}" TextWrapping="Wrap" IsVisible="{Binding UsernameError, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="2,4,0,0" />
          </StackPanel>
          <StackPanel Classes="field">
            <TextBlock Classes="formLabel" Text="Password" />
            <TextBox x:Name="PasswordBox" Text="{Binding Password}" TextInputOptions.ContentType="Password" TextInputOptions.IsSensitive="True" TextInputOptions.AutoCapitalization="False" TextInputOptions.ShowSuggestions="False" Watermark="{Binding PasswordWatermark}" Classes.invalid="{Binding PasswordError, Converter={x:Static ObjectConverters.IsNotNull}}" PasswordChar="●" RevealPassword="False" AutomationProperties.Name="Password" />
            <TextBlock Classes="error" Text="{Binding PasswordError}" TextWrapping="Wrap" IsVisible="{Binding PasswordError, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="2,4,0,0" />
          </StackPanel>

          <TextBlock Classes="section" Text="INCOMING MAIL (IMAP)" Margin="2,14,0,8" />
          <StackPanel Classes="field">
            <TextBlock Classes="formLabel" Text="Server" />
            <TextBox Text="{Binding ImapHost}" TextInputOptions.ContentType="Url" TextInputOptions.AutoCapitalization="False" TextInputOptions.ShowSuggestions="False" Watermark="e.g. imap.yourprovider.no" Classes.invalid="{Binding ImapHostError, Converter={x:Static ObjectConverters.IsNotNull}}" AutomationProperties.Name="Server" />
            <TextBlock Classes="error" Text="{Binding ImapHostError}" TextWrapping="Wrap" IsVisible="{Binding ImapHostError, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="2,4,0,0" />
          </StackPanel>
          <Grid ColumnDefinitions="110,12,*">
          <StackPanel Classes="field">
            <TextBlock Classes="formLabel" Text="Port" />
            <TextBox Text="{Binding ImapPort}" TextInputOptions.ContentType="Digits" Classes.invalid="{Binding ImapPortError, Converter={x:Static ObjectConverters.IsNotNull}}" AutomationProperties.Name="Port" />
            <TextBlock Classes="error" Text="{Binding ImapPortError}" TextWrapping="Wrap" IsVisible="{Binding ImapPortError, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="2,4,0,0" />
          </StackPanel>
            <StackPanel Grid.Column="2" Classes="field">
              <TextBlock Classes="formLabel" Text="Security" />
              <ComboBox ItemsSource="{Binding SecurityOptions}" SelectedItem="{Binding ImapSecurity}" HorizontalAlignment="Stretch" AutomationProperties.Name="INCOMING MAIL (IMAP) security" />
            </StackPanel>
          </Grid>

          <TextBlock Classes="section" Text="OUTGOING MAIL (SMTP)" Margin="2,14,0,8" />
          <StackPanel Classes="field">
            <TextBlock Classes="formLabel" Text="Server" />
            <TextBox Text="{Binding SmtpHost}" TextInputOptions.ContentType="Url" TextInputOptions.AutoCapitalization="False" TextInputOptions.ShowSuggestions="False" Watermark="e.g. smtp.yourprovider.no" Classes.invalid="{Binding SmtpHostError, Converter={x:Static ObjectConverters.IsNotNull}}" AutomationProperties.Name="Server" />
            <TextBlock Classes="error" Text="{Binding SmtpHostError}" TextWrapping="Wrap" IsVisible="{Binding SmtpHostError, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="2,4,0,0" />
          </StackPanel>
          <Grid ColumnDefinitions="110,12,*">
          <StackPanel Classes="field">
            <TextBlock Classes="formLabel" Text="Port" />
            <TextBox Text="{Binding SmtpPort}" TextInputOptions.ContentType="Digits" Classes.invalid="{Binding SmtpPortError, Converter={x:Static ObjectConverters.IsNotNull}}" AutomationProperties.Name="Port" />
            <TextBlock Classes="error" Text="{Binding SmtpPortError}" TextWrapping="Wrap" IsVisible="{Binding SmtpPortError, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="2,4,0,0" />
          </StackPanel>
            <StackPanel Grid.Column="2" Classes="field">
              <TextBlock Classes="formLabel" Text="Security" />
              <ComboBox ItemsSource="{Binding SecurityOptions}" SelectedItem="{Binding SmtpSecurity}" HorizontalAlignment="Stretch" AutomationProperties.Name="OUTGOING MAIL (SMTP) security" />
            </StackPanel>
          </Grid>

          <Border Classes="banner" Margin="0,6,0,0">
            <Grid ColumnDefinitions="Auto,*">
              <controls:IconView Data="{StaticResource Icon.Lock}" Width="17" Height="17" Foreground="{DynamicResource Hcg.Accent}" VerticalAlignment="Top" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding CredentialStorageNote}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Hcg.Text.Secondary}" />
            </Grid>
          </Border>
          <Border Classes="banner" Margin="0,8,0,0">
            <Grid ColumnDefinitions="Auto,*">
              <controls:IconView Data="{StaticResource Icon.Shield}" Width="17" Height="17" Foreground="{DynamicResource Hcg.Accent}" VerticalAlignment="Top" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Hcg.Text.Secondary}"
                         Text="HCG Mail only makes encrypted connections and always verifies the server's certificate, including its revocation status. If STARTTLS is chosen and the server does not offer it, the connection is refused rather than continuing unencrypted." />
            </Grid>
          </Border>

          <!-- Connection diagnostics -->
          <TextBlock Classes="section" Text="CONNECTION TEST" Margin="2,22,0,4" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Margin="2,0,0,10" Text="Checks each step separately. Signs in to both servers but never sends an email." />
          <Border Classes="group">
            <StackPanel Spacing="4">
              <ItemsControl x:Name="Steps" ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="app:ConnectionStepViewModel">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,8">
                      <Panel Width="24" VerticalAlignment="Top" Margin="0,1,0,0">
                        <Ellipse Width="16" Height="16" Stroke="{DynamicResource Hcg.Border.Strong}" StrokeThickness="1.5" IsVisible="{Binding IsPending}" />
                        <controls:IconView Classes="stepIcon" Data="{StaticResource Icon.Refresh}" Foreground="{DynamicResource Hcg.Warning}" IsVisible="{Binding IsRunning}" />
                        <controls:IconView Classes="stepIcon" Data="{StaticResource Icon.Check}" Foreground="{DynamicResource Hcg.Success}" StrokeThickness="2.4" IsVisible="{Binding IsPassed}" />
                        <controls:IconView Classes="stepIcon" Data="{StaticResource Icon.Close}" Foreground="{DynamicResource Hcg.Danger}" StrokeThickness="2.4" IsVisible="{Binding IsFailed}" />
                        <controls:IconView Classes="stepIcon" Data="{StaticResource Icon.Dot}" Foreground="{DynamicResource Hcg.Text.Tertiary}" StrokeThickness="5" IsVisible="{Binding IsSkipped}" />
                      </Panel>
                      <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="3">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" FontSize="13" Foreground="{DynamicResource Hcg.Text.Secondary}" TextWrapping="Wrap"
                                   IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="TestSummary" Text="{Binding TestSummary}" IsVisible="{Binding HasTestSummary}" TextWrapping="Wrap" FontSize="14"
                         Foreground="{DynamicResource Hcg.Text.Primary}" />
              <Button x:Name="TestButton" Classes="subtle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Command="{Binding TestConnectionCommand}" Content="{Binding TestButtonText}" />
            </StackPanel>
          </Border>

          <TextBlock Classes="error" Text="{Binding FormError}" IsVisible="{Binding HasFormError}" TextWrapping="Wrap" Margin="2,14,0,0" />
          <Button Classes="ghost danger" Content="Remove account" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,18,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
