<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HCG.Mail.App.Views.BrandMark">
  <StackPanel Orientation="Horizontal" Spacing="9">
    <!-- Official HCG logo (assets/branding/hcg-logo-source.png), transparent version at ~6× display size
         for sharp rendering on high-DPI screens. The backing is transparent in HCG Future and a slim
         graphite plate in HCG Classic, because the artwork is designed for a dark background. -->
    <Border Background="{DynamicResource Hcg.Brush.LogoBacking}" CornerRadius="7" Padding="{DynamicResource Hcg.LogoPadding}"
            VerticalAlignment="Center">
      <Image Source="/Assets/Branding/hcg-logo.png" Height="{DynamicResource Hcg.LogoHeight}" Stretch="Uniform"
             RenderOptions.BitmapInterpolationMode="HighQuality"
             ToolTip.Tip="Hakmi Capital Group" />
    </Border>
    <StackPanel VerticalAlignment="Center" Spacing="1">
      <TextBlock Classes="wordmark" Text="HCG MAIL" FontSize="16" />
      <TextBlock Text="HAKMI CAPITAL GROUP" FontSize="8.5" LetterSpacing="1.6" FontWeight="SemiBold"
                 Foreground="{DynamicResource Hcg.Text.Tertiary}" />
    </StackPanel>
  </StackPanel>
</UserControl>
