<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HCG.Mail.App.ViewModels"
             xmlns:views="using:HCG.Mail.App.Views"
             xmlns:controls="using:HCG.Mail.App.Controls"
             x:Class="HCG.Mail.App.Views.NavigationPane"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.Styles>
    <Style Selector="ListBox.nav ListBoxItem" x:DataType="vm:FolderViewModel">
      <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
    </Style>
    <Style Selector="Border.selectionBar">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.selectionBar">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:selected controls|IconView.folderIcon">
      <Setter Property="Foreground" Value="{DynamicResource Hcg.Accent}" />
    </Style>
    <Style Selector="Ellipse.status">
      <Setter Property="Fill" Value="{DynamicResource Hcg.Neutral}" />
    </Style>
    <Style Selector="Ellipse.status.connected">
      <Setter Property="Fill" Value="{DynamicResource Hcg.Success}" />
    </Style>
    <Style Selector="Ellipse.status.connecting">
      <Setter Property="Fill" Value="{DynamicResource Hcg.Warning}" />
    </Style>
    <Style Selector="Ellipse.status.error">
      <Setter Property="Fill" Value="{DynamicResource Hcg.Danger}" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource Hcg.Bg.Sidebar}" BorderBrush="{DynamicResource Hcg.Border.Subtle}" BorderThickness="0,0,1,0">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="14,16,14,10">

      <views:BrandMark Grid.Row="0" Margin="4,0,0,20" />

      <!-- Compose -->
      <Border Grid.Row="1" CornerRadius="10" BoxShadow="{DynamicResource Hcg.Shadow.Glow}" Margin="0,0,0,16">
        <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,10"
                Command="{Binding ComposeCommand}" ToolTip.Tip="New message (Ctrl+N)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <controls:IconView Data="{StaticResource Icon.Compose}" Width="17" Height="17" StrokeThickness="2" />
            <TextBlock Text="Compose" FontSize="13.5" />
          </StackPanel>
        </Button>
      </Border>

      <!-- Connected account -->
      <StackPanel Grid.Row="2" Spacing="6" Margin="0,0,0,10" IsVisible="{Binding HasSelectedAccount}">
        <Border Classes="card" Padding="10" CornerRadius="12" BoxShadow="{DynamicResource Hcg.Shadow.None}">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Hcg.Brush.Avatar}" VerticalAlignment="Top">
              <TextBlock Text="{Binding SelectedAccount.Initials}" FontWeight="SemiBold" FontSize="13" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="1">
              <TextBlock Text="{Binding SelectedAccount.DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding SelectedAccount.EmailAddress}" Classes="caption" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding SelectedAccount.EmailAddress}" />
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" ToolTip.Tip="{Binding SelectedAccount.StatusText}">
                <Ellipse Classes="status" Width="7" Height="7" VerticalAlignment="Center"
                         Classes.connected="{Binding SelectedAccount.IsConnected}"
                         Classes.connecting="{Binding SelectedAccount.IsConnecting}"
                         Classes.pulse="{Binding SelectedAccount.IsConnecting}"
                         Classes.error="{Binding SelectedAccount.HasError}" />
                <TextBlock Text="{Binding SelectedAccount.StatusText}" FontSize="11" Foreground="{DynamicResource Hcg.Text.Secondary}"
                           TextTrimming="CharacterEllipsis" MaxWidth="160" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
        <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" HorizontalAlignment="Stretch"
                  IsVisible="{Binding HasMultipleAccounts}" PlaceholderText="Switch account">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AccountViewModel">
              <TextBlock Text="{Binding EmailAddress}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <!-- Folders -->
      <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled" Margin="-4,0">
        <StackPanel Spacing="2" Margin="4,0">
          <TextBlock Classes="section" Text="MAILBOX" Margin="10,6,0,6" IsVisible="{Binding HasSelectedAccount}" />
          <ListBox Classes="nav" ItemsSource="{Binding SelectedAccount.StandardFolders}"
                   SelectedItem="{Binding SelectedStandardFolder}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FolderViewModel">
                <Grid ColumnDefinitions="3,Auto,*,Auto" Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
                  <Border Classes="selectionBar" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource Hcg.Accent}"
                          BoxShadow="{DynamicResource Hcg.Shadow.GlowSoft}" VerticalAlignment="Center" />
                  <controls:IconView Classes="folderIcon" Grid.Column="1" Data="{Binding Icon}" Width="17" Height="17" Margin="9,0,10,0" />
                  <TextBlock Grid.Column="2" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="3" IsVisible="{Binding HasUnread}" Background="{DynamicResource Hcg.Bg.AccentSoft}"
                          CornerRadius="8" Padding="7,1" Margin="6,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UnreadText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Hcg.Text.Accent}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Classes="section" Text="FOLDERS" Margin="10,14,0,6" IsVisible="{Binding SelectedAccount.HasOtherFolders, FallbackValue=False}" />
          <ListBox Classes="nav" ItemsSource="{Binding SelectedAccount.OtherFolders}"
                   SelectedItem="{Binding SelectedOtherFolder}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FolderViewModel">
                <Grid ColumnDefinitions="3,Auto,*,Auto" Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
                  <Border Classes="selectionBar" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource Hcg.Accent}" VerticalAlignment="Center" />
                  <controls:IconView Classes="folderIcon" Grid.Column="1" Data="{Binding Icon}" Width="16" Height="16" Margin="9,0,10,0" />
                  <TextBlock Grid.Column="2" Text="{Binding DisplayName}" Margin="{Binding Indent}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="3" Text="{Binding UnreadText}" IsVisible="{Binding HasUnread}" Classes="caption" Margin="6,0,10,0" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </ScrollViewer>

      <!-- Settings -->
      <StackPanel Grid.Row="4" Spacing="1" Margin="0,10,0,0">
        <Rectangle Height="1" Fill="{DynamicResource Hcg.Brush.AccentLine}" Margin="6,0,6,8" />
        <Button Classes="nav" Command="{Binding OpenAccountSettingsCommand}" ToolTip.Tip="Server settings for this account">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <controls:IconView Data="{StaticResource Icon.Account}" Width="17" Height="17" />
            <TextBlock Text="Account settings" />
          </StackPanel>
        </Button>
        <Button Classes="nav" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Appearance, notifications, downloads and more">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <controls:IconView Data="{StaticResource Icon.Settings}" Width="17" Height="17" />
            <TextBlock Text="Application settings" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
