<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HCG.Mail.App.ViewModels"
             xmlns:html="using:TheArtOfDev.HtmlRenderer.Avalonia"
             x:Class="HCG.Mail.App.Views.MessageBodyView"
             x:DataType="vm:MessageReaderViewModel">
  <Panel>
    <!-- Sanitized HTML on the email's own page colour (white unless the email sets one): the app theme never
         leaks into message content, and message styles never reach the app. -->
    <Border Classes="paper" IsVisible="{Binding ShowHtmlView}" Background="{Binding HtmlBackground}">
      <html:HtmlPanel x:Name="Html" Text="{Binding SanitizedHtml}" Background="{Binding HtmlBackground}"
                      IsContextMenuEnabled="False" IsSelectionEnabled="True"
                      BaseStylesheet="{Binding HtmlStylesheet}" />
    </Border>

    <!-- Plain text -->
    <ScrollViewer IsVisible="{Binding ShowTextView}" HorizontalScrollBarVisibility="Disabled">
      <SelectableTextBlock x:Name="PlainText" Text="{Binding TextBody}" TextWrapping="Wrap" FontSize="14" LineHeight="22"
                           Foreground="{DynamicResource Hcg.Text.Primary}" Margin="2,4,12,24"
                           SelectionBrush="{DynamicResource Hcg.Bg.Selected}" />
    </ScrollViewer>

    <!-- A message that genuinely has no content -->
    <StackPanel IsVisible="{Binding IsEmptyMessage}" Margin="2,10" Spacing="6">
      <TextBlock x:Name="EmptyMessage" Text="{Binding EmptyMessageText}" Classes="muted" FontSize="13.5" />
      <TextBlock Text="The sender's message contains no text or images." Classes="caption" />
    </StackPanel>
  </Panel>
</UserControl>
