<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>HCG.Mail.App</RootNamespace>
    <AssemblyName>HCGMail</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Icons\hcg-mail.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HCG.Mail.Core\HCG.Mail.Core.csproj" />
    <ProjectReference Include="..\HCG.Mail.Email\HCG.Mail.Email.csproj" />
    <ProjectReference Include="..\HCG.Mail.Infrastructure\HCG.Mail.Infrastructure.csproj" />
    <ProjectReference Include="..\HCG.Mail.Presentation\HCG.Mail.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.HtmlRenderer" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HCG.Mail.App.Tests" />
  </ItemGroup>
  <!-- Mailbox sign-in registrations from ../../oauth-clients.props (Microsoft client ID; Google client ID and the
       desktop client secret, which Google does not treat as confidential for installed apps). Empty values make the
       app report that sign-in is not set up. See docs/MICROSOFT_ACCOUNTS.md and docs/GOOGLE_ACCOUNTS.md. -->
  <ItemGroup>
    <AssemblyMetadata Include="HcgMicrosoftClientId" Value="$(HcgMicrosoftClientId)" />
    <AssemblyMetadata Include="HcgGoogleClientId" Value="$(HcgGoogleClientId)" />
    <AssemblyMetadata Include="HcgGoogleClientSecret" Value="$(HcgGoogleClientSecret)" />
  </ItemGroup>
  <Import Project="../../oauth-clients.targets" />
</Project>
